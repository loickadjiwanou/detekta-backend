# ════════════════════════════════════════════════════════════════
#  DETEKTA — Backend Environment Variables
#  Copy this file to .env and fill in your own values.
#  ⚠️  Never commit your .env file to version control.
# ════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────
# Environment: development | production | staging
APP_ENV=development

# ─── Security ────────────────────────────────────────────────────
# JWT secret key — generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# JWT token lifetimes (optional — defaults shown)
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet encryption key (for encrypting stored Claude API keys)
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_generate_fernet_key

# ─── Database — MongoDB ───────────────────────────────────────────
# Local MongoDB
MONGO_URL=mongodb://localhost:27017

# MongoDB Atlas example:
# MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

DB_NAME=detekta

# ─── AI / Claude (Anthropic) ──────────────────────────────────────
# Platform-level LLM key used when users don't bring their own key.
# Obtain from https://console.anthropic.com
AI_LLM_KEY=your_ai_llm_api_key

# Claude model to use for AI analysis.
# Defaults to the most advanced model if not set.
# See available models: https://docs.anthropic.com/en/docs/about-claude/models
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use * to allow all (not recommended for production).
CORS_ORIGINS=http://localhost:3000

# Production example:
# CORS_ORIGINS=https://app.detekta.io,https://www.detekta.io

# ─── File Uploads ─────────────────────────────────────────────────
# Directory where uploaded APK/IPA/source files are stored temporarily.
UPLOAD_DIR=/tmp/detekta_uploads

# Maximum allowed upload size in MB.
MAX_FILE_SIZE_MB=100

# ─── Internationalisation ─────────────────────────────────────────
# Default language for AI reports when user has no preference set.
# Supported values: en | fr
DEFAULT_LANGUAGE=en
